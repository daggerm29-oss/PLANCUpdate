# ==============================================================================
# Corporate Intelligence Crawler - Environment Configuration
# ==============================================================================
# Copy this file to .env and supply your credentials. Never commit .env to git.

# SERPER_API_KEY (Required):
# API token for Serper.dev Google Search and Scrape Gateway.
# Obtain a free key (2,500 free queries) at: https://serper.dev
SERPER_API_KEY="your_serper_api_key_here"

# PORT (Optional):
# Port on which the HTTP service listens. Defaults to 10000 if omitted.
# Render automatically injects this dynamically in production.
PORT="10000"

# GEMINI_API_KEY (Optional / AI Studio runtime only):
# Injected automatically in AI Studio environments for optional LLM extensions.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL (Optional / AI Studio runtime only):
# Canonical deployment URL injected by cloud environments.
APP_URL="http://localhost:10000"
