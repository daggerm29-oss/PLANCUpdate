# Copy to backend/.env (gitignored) and fill in locally. NEVER commit real values.

# --- Storage ---
OSINT_DB_PATH=data/osint.db
OSINT_RAW_DIR=data/raw

# --- HTTP / connectors ---
# Identify yourself to public APIs (SEC EDGAR requires a contact email).
HTTP_USER_AGENT=osint-fin-intel/0.1 (student project; contact: you@example.com)
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
GLEIF_RPM=50
# COMPANIES_HOUSE_API_KEY=   # planned (P11)

# --- AI provider: codex | fake | disabled ---
AI_PROVIDER=codex
AI_MODEL=gpt-5.6-terra

# --- AI request budget (applies centrally to ALL processes sharing the DB) ---
AI_RPM_LIMIT=2
AI_RPM_SAFETY_MARGIN_SECONDS=5
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_RETRIES=1
AI_REQUEST_TIMEOUT=60
AI_CACHE_TTL_SECONDS=3600
AI_DAILY_REQUEST_BUDGET=40
AI_DAILY_TOKEN_BUDGET=0
AI_QUEUE_MAX=8
AI_QUEUE_MAX_WAIT_SECONDS=75
AI_BACKGROUND_RESERVE=10
AI_429_COOLDOWN_SECONDS=120

# --- Your existing OAuth method (legacy_ai/config.py reads these names) ---
# Copy the real values from YOUR original config.py (they were redacted in the attachment).
CODEX_CLIENT_ID=
CODEX_AUTH_URL_BASE=
CODEX_TOKEN_URL=
CODEX_CALLBACK_PORT=1455
CODEX_CALLBACK_PATH=/auth/callback
CODEX_REDIRECT_URI=http://localhost:1455/auth/callback
CODEX_TOKEN_FILE=.secrets/codex_tokens.json
CODEX_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses
CODEX_REASONING_EFFORT=low
# Optional: only if the account id cannot be read from your id_token
CODEX_ACCOUNT_ID=
# Same originator value your auth.py sends during login. Change only if your agent.py used another.
CODEX_ORIGINATOR=custom_python_script
# Optional: if the endpoint rejects custom `instructions`, put the instructions your agent.py sends in a
# local file and point to it here; the app's own rules are then sent as a developer message instead.
CODEX_INSTRUCTIONS_FILE=

# --- Web crawler (services/crawler) ---
# Leave empty to disable. Local default when running services/crawler/app.py with PORT=10000:
# CRAWLER_URL=http://127.0.0.1:10000
